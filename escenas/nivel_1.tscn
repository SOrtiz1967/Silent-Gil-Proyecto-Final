[node name="Cartel01" parent="." instance=ExtResource("51_cartel")]
position = Vector2(2440, 800)
titulo = "ESTACIÓN CONSTITUCIÓN"
texto = "La salida queda al sur, pasando los molinetes: necesitás la SUBE. Tu celular es tu linterna, cuidá la batería (Q la apaga). Se rumorea que en algún lugar del mapa hay un cargador portátil (powerbank): con él tenés 100% de batería el resto del juego, sin volver a cargar. Aparece más o menos a la mitad del recorrido."
rutaTextura = "res://assets/carteles/cartel_bateria.png"

[node name="Cartel02" parent="." instance=ExtResource("51_cartel")]
position = Vector2(1620, 1990)
titulo = "MOLINETES"
texto = "Pasá con la SUBE. ¿No la encontraste? Podés forzar los molinetes igual: con una ganzúa jugás a la cerradura, y sin ganzúa tenés que hacerlo a mano con los pernos. Acercate al molinete y apretá F."
rutaTextura = "res://assets/carteles/cartel_llave.png"

[node name="Cartel03" parent="." instance=ExtResource("51_cartel")]
position = Vector2(2180, 1680)
titulo = "PUNTO DE CARGA"
texto = "Mantené F cerca de un poste celeste para cargar el celular: de 0 a 100% tarda unos 20 segundos. Hay postes en la estación, en la plaza y en el McDonald's."
rutaTextura = "res://assets/carteles/cartel_info.png"

[node name="Cartel04" parent="." instance=ExtResource("51_cartel")]
position = Vector2(668, 700)
titulo = "KIOSCO"
texto = "Golosinas y alfajores, todo tirado ahí en el mostrador. Cada golosina te cura 1 de vida. Acercate y apretá F para comer."
rutaTextura = "res://assets/carteles/cartel_alerta.png"

[node name="Cartel05" parent="." instance=ExtResource("51_cartel")]
position = Vector2(1660, 2322)
titulo = "PLAZA CONSTITUCIÓN"
texto = "Cuidado con los vagabundos: son agresivos y te persiguen. A veces dejan una bebida al caer: tomala para curarte 0,5. Las golosinas curan 1 y las hamburguesas 2."
rutaTextura = "res://assets/carteles/cartel_alerta.png"

[node name="Cartel06" parent="." instance=ExtResource("51_cartel")]
position = Vector2(830, 2670)
titulo = "McDONALD'S"
texto = "Cerrado con llave. Alguien la dejó tirada en algún lugar de la plaza. Si no la encontrás, no hay otra forma de entrar."
rutaTextura = "res://assets/carteles/cartel_llave.png"

[node name="Cartel07" parent="." instance=ExtResource("51_cartel")]
position = Vector2(1700, 2610)
titulo = "RUMORES"
texto = "Dicen que a mitad de camino hay un cargador portátil (powerbank). Con él, tu celular queda siempre al 100% de batería y no tenés que cargarlo nunca más."
rutaTextura = "res://assets/carteles/cartel_bateria.png"

