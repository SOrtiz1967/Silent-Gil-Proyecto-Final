texto = "El reloj de la estación está clavado en las 3:07. Tu celular marca lo mismo, y tenés una llamada perdida de «Casa» de esa hora. El tren que te dejó se fue despacio y no vuelve."
rutaTextura = "res://assets/carteles/cartel_info.png"

[node name="CartelSubte" parent="." instance=ExtResource("51_cartel")]
position = Vector2(3440, 2500)
titulo = "LÍNEA C"
texto = "CERRADO POR OBRAS. Llaves en custodia del local de la esquina. No dice cuál. El único local de la esquina es el McDonald's. Por las avenidas no se puede salir: la niebla te devuelve a la plaza."
rutaTextura = "res://assets/carteles/cartel_llave.png"

